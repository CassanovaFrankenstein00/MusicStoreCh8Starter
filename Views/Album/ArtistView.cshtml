@using MusicStore.Models;
@using MusicStore.ViewModels;

@model ArtistViewModel
@{
    ViewData["Title"] = "Artists and Albums";
}
<div class="row">
    <h1 class="test-center col-md-12">@ViewBag.Title</h1>
</div>
<div class="row">
    @foreach (Artist artist in Model.Artist)
    {
        <h4>@artist.Name</h4>
        <ul>
            @foreach (Album album in Model.Album)
            {
                @if (artist.ArtistId == album.AlbumId)
                {
                    <li>@album.Title</li>
                }
            }
        </ul>
    } 
</div>
    <div class="col-md-8">
        <img class="img-fluid shadow p-4" src="~/images/rock.jpg"
        style="width:100%;z-index:auto;border-radius:30px;" />
    </div>
</div>